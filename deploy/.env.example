# Copy to deploy/.env and fill in. Never commit deploy/.env. See docs/deploy.md.
# Generate each secret with:  openssl rand -base64 48

# ── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# The address people open in the browser (https; TLS ends at your reverse proxy).
PUBLIC_URL=https://agents.example.com
POSTGRES_PASSWORD=
# Sessions, agent tokens, and the credential vault. Different values, each ≥ 32 characters.
BETTER_AUTH_SECRET=
JWT_SECRET=
# ⚠ Not in any backup. Lose it and every stored credential (model keys, GitLab tokens) is gone.
MASTER_KEY=
# Host directory for workspaces, repo mirror cache and artifacts; mounted at the same path in the app.
DATA_PATH=/srv/agent-platform/data
# Group id of /var/run/docker.sock on the host:  stat -c %g /var/run/docker.sock
DOCKER_GID=

# ── Sign-up ──────────────────────────────────────────────────────────────────
# invite (default) | domain (with AUTH_ALLOWED_EMAIL_DOMAINS). "open" is refused in production.
AUTH_SIGNUP_MODE=invite
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC (all three or none):
# OIDC_ISSUER=  OIDC_CLIENT_ID=  OIDC_CLIENT_SECRET=

# ── Sandbox (production requires docker) ─────────────────────────────────────
SANDBOX=docker
# Default image for repos that don't set one; must contain the repo's toolchain (and git).
SANDBOX_IMAGE=oven/bun:1.4.4-alpine
# Only images from these prefixes may run (SBX-09).
SANDBOX_IMAGE_ALLOW=oven/bun:,registry.example.com/
# For external engines (Claude Code / Codex / OpenCode / pi): an internal network whose only
# reachable host is the platform. Then run deploy/sandbox-firewall.sh as root (docs/deploy.md).
# SANDBOX_NETWORK=ap-sandbox
# SANDBOX_RUNTIME=runsc

# ── Model (optional here: also configurable in the console under 模型与预算) ─
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_MODEL=
# LLM_API_KEY=
# Internal model / GitLab hosts must be allowlisted (SSRF guard), e.g. an on-prem GitLab and Ollama:
# OUTBOUND_ALLOW=gitlab.internal,10.0.5.20:11434

# ── Build ─────────────────────────────────────────────────────────────────────
# Behind a proxy that inspects TLS: copy its CA certificate (PEM) to deploy/build-ca.pem (gitignored);
# used only during `docker compose build`.
# BUILD_CA_FILE=./build-ca.pem

# ── Operations ───────────────────────────────────────────────────────────────
# Prometheus scrape token for GET /metrics (without it /metrics is off in production).
# METRICS_TOKEN=
# Data retention cleanup (off by default; periods in days).
# RETENTION_ENABLED=true
# Bind address/port published on the host; put a TLS reverse proxy in front.
APP_BIND=127.0.0.1
APP_PORT=3000
