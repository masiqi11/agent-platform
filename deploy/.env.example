# 复制为 deploy/.env 并填写。生产环境缺少任一必填项时进程拒绝启动（只打印变量名）。
NODE_ENV=production
PUBLIC_URL=https://agents.example.com
POSTGRES_PASSWORD=
DATABASE_URL=postgres://agent:<POSTGRES_PASSWORD>@postgres:5432/agent_platform
BETTER_AUTH_SECRET=
JWT_SECRET=
MASTER_KEY=
AUTH_SIGNUP_MODE=invite
SANDBOX=docker
# docker 沙箱：应用需要能访问 Docker daemon（例如 DOCKER_HOST）；沙箱容器本身不挂载 docker socket。
# 应用若运行在容器里，WORKSPACES_DIR 必须是宿主机上的同一路径（docker -v 按宿主路径挂载）。
SANDBOX_IMAGE=oven/bun:1.4.4-alpine
# SANDBOX_RUNTIME=runsc      # 可选：gVisor
