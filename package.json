{
  "name": "agent-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --type-aware -c .oxlintrc.json apps packages && bun scripts/check-deps.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "migrate": "bun --cwd apps/server src/cli/migrate.ts",
    "seed": "bun --cwd apps/server src/cli/seed.ts",
    "kb:eval": "bun --cwd apps/server src/cli/kb-eval.ts",
    "audit:verify": "bun --cwd apps/server src/cli/audit-verify.ts",
    "start": "bun --cwd apps/server src/main.ts",
    "e2e": "cd apps/web && bun x --no-install playwright test",
    "rekey": "bun --cwd apps/server src/cli/rekey.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
