# 本地开发示例（复制为 .env 后修改）。不要把真实密钥提交到仓库。
DATABASE_URL=postgres://agent:<password>@127.0.0.1:5432/agent_platform
TEST_DATABASE_URL=postgres://agent:<password>@127.0.0.1:5432/agent_platform_test
DEMO_MODE=true
# 可选：本地 Ollama（OpenAI 兼容端点）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=gemma4:e2b   # 端口 11434 自动走 Ollama 原生 /api/chat 且 think:false；不配则只有脚本模型
# S5 沙箱与仓库（开发默认 process 沙箱；数据目录下有 local-scm/ workspaces/ repo-cache/ artifacts/）
# SANDBOX=process            # 或 docker（生产必须 docker）
# SANDBOX_IMAGE=oven/bun:1.4.4-alpine
# SANDBOX_TIMEOUT_MS=600000
# DATA_DIR=.data
